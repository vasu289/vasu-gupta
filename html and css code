/* General Styles */
body {
  font-family: Arial, sans-serif;
  text-align: center;
  background-color: #e6ffe6; /* Light green background */
  margin: 0;
  padding: 20px;
}

/* Headings and Paragraphs */
h1 {
  color: #3f004d;
  font-size: 32px;
  margin-bottom: 10px;
}

p {
  font-size: 18px;
  color: #222;
}

/* Images */
img {
  width: 80%;
  max-width: 500px;
  margin: 20px auto;
  border-radius: 10px;
  display: block;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.726);
  transition: transform 0.3s ease;
}

img:hover {
  transform: scale(1.03);
}

/* Optional Footer Style */
footer {
  background-color: #00084d;
  color: white;
  padding: 10px;
  margin-top: 40px;
  font-size: 14px;
}
