#!/usr/bin/env python3
# gui_led_controller.py
# Tkinter GUI to control 3 same-color LEDs (rewritten version)

try:
    from gpiozero import LED
    hardware = True
except ImportError:
    # mock LED class for testing without Raspberry Pi
    class LED:
        def __init__(self, pin):
            self.pin = pin
            self.state = False
        def on(self):
            self.state = True
            print(f"[TEST] LED {self.pin} ON")
        def off(self):
            self.state = False
            print(f"[TEST] LED {self.pin} OFF")
    hardware = False

import tkinter as tk

# GPIO pin numbers
PINS = [17, 27, 22]

# Create LED objects
leds = [LED(pin) for pin in PINS]

def activate_led(index):
    """Turn only the selected LED on."""
    for i, led in enumerate(leds):
        if i == index:
            led.on()
        else:
            led.off()
    msg_var.set(f"LED {index+1} is ON")

def turn_all_off():
    """Switch off all LEDs."""
    for led in leds:
        led.off()
    msg_var.set("All LEDs OFF")

def quit_app():
    turn_all_off()
    window.destroy()

# --- GUI setup ---
window = tk.Tk()
window.title("LED Selector")
window.geometry("400x200")
window.configure(bg="#f2f2f2")

title = tk.Label(window, text="Select an LED to activate", font=("Helvetica", 13, "bold"), bg="#f2f2f2")
title.pack(pady=10)

# Radio buttons for LED selection
choice = tk.IntVar(value=-1)
radio_frame = tk.Frame(window, bg="#f2f2f2")
radio_frame.pack(pady=5)

for i in range(3):
    rb = tk.Radiobutton(radio_frame, text=f"LED {i+1}", variable=choice, value=i,
                        command=lambda idx=i: activate_led(idx), font=("Arial", 11), bg="#f2f2f2")
    rb.pack(side="left", padx=12)

# Status label
msg_var = tk.StringVar(value="All LEDs OFF")
status = tk.Label(window, textvariable=msg_var, font=("Arial", 11), fg="blue", bg="#f2f2f2")
status.pack(pady=15)

# Buttons
btn_frame = tk.Frame(window, bg="#f2f2f2")
btn_frame.pack(pady=5)

tk.Button(btn_frame, text="Turn OFF", width=12, command=turn_all_off, bg="lightgray").pack(side="left", padx=8)
tk.Button(btn_frame, text="Exit", width=12, command=quit_app, bg="tomato").pack(side="left", padx=8)

window.protocol("WM_DELETE_WINDOW", quit_app)
window.mainloop()
